{
  "name": "@lagomkit/queue",
  "version": "1.1.1",
  "type": "module",
  "keywords": [
    "pg-boss",
    "queue",
    "jobs",
    "typescript",
    "lagomkit"
  ],
  "author": "Chirill Ceban <cc@bitkidd.dev>",
  "license": "MIT",
  "description": "Type-safe queue service based on pg-boss with declared tasks, inferred payloads, and auto-registered workers.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitkidd/lagomkit.git"
  },
  "main": "./dist/src/exports.js",
  "types": "./dist/src/exports.d.ts",
  "sideEffects": false,
  "directories": {
    "test": "tests"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "npm run build",
    "prepublishOnly": "npm run test",
    "build": "rm -rf dist/* && tsgo --project tsconfig.build.json",
    "check": "biome check --write",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "test": "vitest run --sequence.concurrent",
    "coverage": "vitest run --coverage"
  },
  "files": [
    "/dist/"
  ],
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/src/exports.d.ts",
      "import": "./dist/src/exports.js",
      "default": "./dist/src/exports.js"
    },
    "./service": {
      "types": "./dist/src/service.d.ts",
      "import": "./dist/src/service.js",
      "default": "./dist/src/service.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "import": "./dist/src/types.js",
      "default": "./dist/src/types.js"
    }
  },
  "dependencies": {
    "pg-boss": "^12.38.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@electric-sql/pglite": "^0.5.11",
    "@tsconfig/node24": "^24.0.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2"
  }
}
